# Build from the repo root: docker build -f project/Dockerfile.prod .

# --- Build stage: install runtime dependencies from uv.lock ---
FROM python:3.13-slim AS build

LABEL maintainer="Robin Opdam"

COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/usr/src/.venv

WORKDIR /usr/src
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --no-install-project

# --- Runtime stage ---
FROM python:3.13-slim

RUN useradd --create-home app && install -d -o app /usr/src/app

# Same path as in the build stage: the venv's scripts use absolute shebangs
COPY --from=build /usr/src/.venv /usr/src/.venv
ENV PATH=/usr/src/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1

WORKDIR /usr/src/app
# Chainlit writes translations and uploaded files into the app dir at runtime
COPY --chown=app project/app/ ./
USER app

EXPOSE 8000

CMD ["chainlit", "run", "app.py", "--headless", "--host", "0.0.0.0", "--port", "8000"]
